{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Ballot API",
    "version": "1.0.0",
    "description": "Secure, anonymous and receipt-verifiable online voting. All endpoints are available under both /api (legacy) and /api/v1. Mutating requests require a CSRF token in the X-CSRF-Token header and an Origin matching the host. Errors use the envelope { error: { code, message, timestamp, details? } }.",
    "contact": {
      "name": "Open Ballot"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000/api/v1",
      "description": "Local development"
    },
    {
      "url": "https://open-ballot.onrender.com/api/v1",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ob_session"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "message",
              "code",
              "timestamp"
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "app": {
            "type": "string"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "appName": {
            "type": "string"
          },
          "openElections": {
            "type": "integer"
          },
          "scheduledElections": {
            "type": "integer"
          },
          "completedElections": {
            "type": "integer"
          },
          "ballotsCast": {
            "type": "integer"
          },
          "registeredVoters": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
